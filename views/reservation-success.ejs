<%- include('partials/header') %>
<section class="success-card"><div class="success-icon">✓</div><p class="eyebrow">RESERVASI TERCATAT</p><h1>Booking kamu berhasil dibuat.</h1><p class="muted">Simpan kode ini dan tunjukkan kepada admin saat datang ke warnet.</p><div class="booking-code"><%= reservation.booking_code %></div><div class="detail-grid"><div><span>Nama</span><strong><%= reservation.customer_name %></strong></div><div><span>PC</span><strong><%= reservation.computer_code %> - <%= reservation.computer_name %></strong></div><div><span>Tanggal</span><strong><%= formatDate(reservation.booking_date) %></strong></div><div><span>Jam</span><strong><%= toTime(reservation.start_time) %> - <%= toTime(reservation.end_time) %></strong></div><div><span>Durasi</span><strong><%= reservation.duration_hours %> jam</strong></div><div><span>Total cash</span><strong><%= currency(reservation.total_price) %></strong></div></div><div class="notice">Metode pembayaran: <strong>CASH DI WARNET</strong>. Datang sesuai jadwal agar booking dapat dikonfirmasi.</div><div class="actions"><a class="btn secondary" href="/">Kembali</a><a class="btn primary" href="/cek-reservasi">Cek Booking</a></div></section>
<%- include('partials/footer') %>
