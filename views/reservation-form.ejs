<%- include('partials/header') %>
<div class="page-head"><p class="eyebrow">RESERVASI ONLINE</p><h1>Pesan slot warnet</h1><p class="muted">Isi data di bawah. Pembayaran dilakukan <strong>cash langsung di warnet</strong>.</p></div>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form class="form-card" method="POST" action="/reservasi" id="reservation-form">
  <div class="form-section"><h2>Data pelanggan</h2><div class="form-grid"><label>Nama lengkap<input name="customer_name" required value="<%= form.customer_name || '' %>" placeholder="Nama kamu"></label><label>No. HP<input name="phone" required value="<%= form.phone || '' %>" placeholder="08xxxxxxxxxx"></label><label>Email (opsional)<input type="email" name="email" value="<%= form.email || '' %>" placeholder="kamu@email.com"></label><label>Catatan (opsional)<input name="notes" value="<%= form.notes || '' %>" placeholder="Mis. ingin PC dekat teman"></label></div></div>
  <div class="form-section"><h2>Jadwal & PC</h2><div class="form-grid"><label>PC<select name="computer_id" id="computer_id" required><option value="">Pilih PC</option><% pcs.forEach(pc => { %><option value="<%= pc.id %>" data-price="<%= pc.hourly_price %>" <%= String(form.computer_id) === String(pc.id) ? 'selected' : '' %>><%= pc.code %> - <%= pc.rate_name %> - <%= currency(pc.hourly_price) %>/jam</option><% }) %></select></label><label>Tanggal<input type="date" name="booking_date" required value="<%= form.booking_date || '' %>" min="<%= new Date().toISOString().slice(0,10) %>"></label><label>Jam mulai<input type="time" name="start_time" required value="<%= form.start_time || '10:00' %>"></label><label>Durasi<select name="duration_hours" id="duration_hours" required><% for(let i=1;i<=12;i++){ %><option value="<%= i %>" <%= String(form.duration_hours || 1) === String(i) ? 'selected' : '' %>><%= i %> jam</option><% } %></select></label></div></div>
  <div class="summary"><div><span class="muted">Pembayaran</span><strong>Cash di warnet</strong></div><div><span class="muted">Perkiraan total</span><strong id="total-price">Rp0</strong></div></div>
  <button class="btn primary wide" type="submit">Kirim Reservasi</button>
</form>
<%- include('partials/footer') %>
