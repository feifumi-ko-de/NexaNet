<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title><link rel="stylesheet" href="/css/style.css">
</head>
<body>
<main class="login-page">
  <form class="login-card register-card" method="POST" action="/akun/register">
    <div class="brand center">NEXA<span>NET</span></div>
    <p class="eyebrow">AKUN PELANGGAN BARU</p>
    <h1>Buat Akun</h1>
    <p class="muted small">Daftar gratis untuk pengalaman reservasi NexaNet yang lebih praktis.</p>
    <% if(error){ %><div class="alert error"><%= error %></div><% } %>
    <label>Nama lengkap<input name="full_name" value="<%= form?.full_name || '' %>" autocomplete="name" required></label>
    <label>Username<input name="username" value="<%= form?.username || '' %>" autocomplete="username" minlength="4" maxlength="30" required></label>
    <label>Email<input name="email" type="email" value="<%= form?.email || '' %>" autocomplete="email" required></label>
    <label>Nomor HP<input name="phone" value="<%= form?.phone || '' %>" autocomplete="tel" required></label>
    <label>Password<input name="password" type="password" autocomplete="new-password" minlength="6" required></label>
    <label>Konfirmasi password<input name="password_confirm" type="password" autocomplete="new-password" minlength="6" required></label>
    <button class="btn primary wide" type="submit">Daftar Akun</button>
    <p class="center muted small">Sudah punya akun? <a class="accent-link" href="/akun/login">Masuk di sini</a></p>
    <a href="/" class="center muted small">Kembali ke situs</a>
  </form>
</main>
</body>
</html>
