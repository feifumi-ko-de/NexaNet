<%- include('header') %><div class="page-head"><p class="eyebrow">MASTER DATA</p><h1><%= title %></h1></div><form class="form-card narrow" method="POST" action="<%= action %>"><div class="form-grid"><label>Kode PC<input name="code" required value="<%= pc.code || '' %>" placeholder="PC-06"></label><label>Nama PC<input name="name" required value="<%= pc.name || '' %>" placeholder="Nexa Gaming 03"></label><label>Tarif<select name="rate_id" required><% rates.forEach(r=>{ %><option value="<%= r.id %>" <%= String(pc.rate_id)===String(r.id)?'selected':'' %>><%= r.name %> - <%= currency(r.hourly_price) %>/jam</option><% }) %></select></label><label>Status<select name="status"><% ['AVAILABLE','MAINTENANCE','INACTIVE'].forEach(s=>{ %><option value="<%= s %>" <%= (pc.status||'AVAILABLE')===s?'selected':'' %>><%= s %></option><% }) %></select></label><label class="full">Spesifikasi<input name="specs" value="<%= pc.specs || '' %>" placeholder="Core i5 / 16 GB RAM / RTX 2060"></label></div><button class="btn primary">Simpan</button></form><%- include('footer') %>