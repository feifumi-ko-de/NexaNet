<%- include('header') %><div class="page-head row-between"><div><p class="eyebrow">MASTER DATA</p><h1>Kelola PC</h1></div><a class="btn primary" href="/admin/pcs/new">+ Tambah PC</a></div><div class="table-wrap"><table><thead><tr><th>Kode</th><th>Nama</th><th>Tarif</th><th>Status</th><th>Spesifikasi</th><th>Aksi</th></tr></thead><tbody><% pcs.forEach(p=>{ %><tr><td><strong><%= p.code %></strong></td><td><%= p.name %></td><td><%= p.rate_name %></td><td><span class="tag <%= p.status.toLowerCase() %>"><%= p.status %></span></td><td><%= p.specs || '-' %></td><td class="actions-cell"><a href="/admin/pcs/<%= p.id %>/edit">Edit</a><form method="POST" action="/admin/pcs/<%= p.id %>?_method=DELETE" onsubmit="return confirm('Hapus PC ini?')"><button class="danger-link">Hapus</button></form></td></tr><% }) %></tbody></table></div><%- include('footer') %>