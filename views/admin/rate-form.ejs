<%- include('header') %><div class="page-head"><p class="eyebrow">MASTER DATA</p><h1><%= title %></h1></div><form class="form-card narrow" method="POST" action="<%= action %>"><div class="form-grid"><label>Nama tarif<input name="name" required value="<%= rate.name || '' %>" placeholder="Gaming"></label><label>Harga per jam<input type="number" name="hourly_price" required min="0" value="<%= rate.hourly_price || '' %>"></label><label class="full">Deskripsi<input name="description" value="<%= rate.description || '' %>" placeholder="PC gaming"></label><label class="checkbox"><input type="checkbox" name="active" value="1" <%= rate.active === undefined || rate.active ? 'checked':'' %>> Tarif aktif</label></div><button class="btn primary">Simpan</button></form><%- include('footer') %>