<%- include('header') %><div class="page-head row-between"><div><p class="eyebrow">MASTER DATA</p><h1>Kelola Tarif</h1></div><a class="btn primary" href="/admin/tarif/new">+ Tambah Tarif</a></div><div class="table-wrap"><table><thead><tr><th>Nama</th><th>Harga/Jam</th><th>Deskripsi</th><th>Aktif</th><th>Aksi</th></tr></thead><tbody><% rates.forEach(r=>{ %><tr><td><strong><%= r.name %></strong></td><td><%= currency(r.hourly_price) %></td><td><%= r.description || '-' %></td><td><span class="tag <%= r.active ? 'paid' : 'inactive' %>"><%= r.active ? 'YA':'TIDAK' %></span></td><td class="actions-cell"><a href="/admin/tarif/<%= r.id %>/edit">Edit</a><form method="POST" action="/admin/tarif/<%= r.id %>?_method=DELETE" onsubmit="return confirm('Hapus tarif ini?')"><button class="danger-link">Hapus</button></form></td></tr><% }) %></tbody></table></div><%- include('footer') %>