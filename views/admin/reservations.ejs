<%- include('header') %><div class="page-head"><p class="eyebrow">TRANSAKSI</p><h1>Kelola Reservasi</h1><p class="muted">Konfirmasi pembayaran setelah pelanggan datang dan membayar cash.</p></div><div class="table-wrap"><table><thead><tr><th>Booking</th><th>Pelanggan</th><th>PC</th><th>Jadwal</th><th>Total</th><th>Status</th><th>Bayar</th><th>Aksi</th></tr></thead><tbody><% reservations.forEach(r=>{ %><tr><td><strong><%= r.booking_code %></strong><br><span class="muted small"><%= formatDate(r.created_at) %></span></td><td><%= r.customer_name %><br><span class="muted small"><%= r.phone %></span></td><td><%= r.computer_code %></td><td><%= formatDate(r.booking_date) %><br><%= toTime(r.start_time) %>-<%= toTime(r.end_time) %></td><td><%= currency(r.total_price) %></td><td><form method="POST" action="/admin/reservasi/<%= r.id %>/status?_method=PUT"><select name="status" onchange="this.form.submit()"><% ['PENDING','CONFIRMED','COMPLETED','CANCELLED'].forEach(s=>{ %><option value="<%= s %>" <%= r.status===s?'selected':'' %>><%= s %></option><% }) %></select></form></td><td><form method="POST" action="/admin/reservasi/<%= r.id %>/payment?_method=PUT"><select name="payment_status" onchange="this.form.submit()"><option value="UNPAID" <%= r.payment_status==='UNPAID'?'selected':'' %>>UNPAID</option><option value="PAID" <%= r.payment_status==='PAID'?'selected':'' %>>PAID</option></select></form></td><td><form method="POST" action="/admin/reservasi/<%= r.id %>?_method=DELETE" onsubmit="return confirm('Hapus reservasi?')"><button class="danger-link">Hapus</button></form></td></tr><% }) %></tbody></table></div><%- include('footer') %>