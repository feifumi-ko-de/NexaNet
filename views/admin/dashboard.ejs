<%- include('header') %><div class="page-head"><p class="eyebrow">DASHBOARD</p><h1>Selamat datang, <%= admin?.name || 'Admin' %>.</h1></div><div class="stat-grid"><div class="stat"><span>Reservasi hari ini</span><strong><%= stats.today_reservations %></strong></div><div class="stat"><span>PC tersedia</span><strong><%= stats.available_pcs %></strong></div><div class="stat"><span>Pendapatan tercatat hari ini</span><strong><%= currency(stats.today_revenue) %></strong></div><div class="stat"><span>Total PC</span><strong><%= computers.total || 0 %></strong></div></div><section class="section"><div class="section-head"><h2>Reservasi terbaru</h2><a class="btn secondary small-btn" href="/admin/reservasi">Lihat semua</a></div><div class="table-wrap"><table><thead><tr><th>Booking</th><th>Pelanggan</th><th>PC</th><th>Jadwal</th><th>Status</th><th>Bayar</th></tr></thead><tbody><% reservations.forEach(r=>{ %><tr><td><%= r.booking_code %></td><td><%= r.customer_name %></td><td><%= r.computer_code %></td><td><%= formatDate(r.booking_date) %> / <%= toTime(r.start_time) %></td><td><span class="tag <%= r.status.toLowerCase() %>"><%= r.status %></span></td><td><span class="tag <%= r.payment_status.toLowerCase() %>"><%= r.payment_status %></span></td></tr><% }) %></tbody></table></div></section><%- include('footer') %>