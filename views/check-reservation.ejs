<%- include('partials/header') %>
<div class="page-head"><p class="eyebrow">CEK BOOKING</p><h1>Lihat status reservasi</h1><p class="muted">Masukkan kode booking dan nomor HP yang digunakan saat reservasi.</p></div>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form class="form-card narrow" method="POST" action="/cek-reservasi"><div class="form-grid"><label>Kode booking<input name="booking_code" required placeholder="NEXA-20261004-ABCD"></label><label>No. HP<input name="phone" required placeholder="08xxxxxxxxxx"></label></div><button class="btn primary wide" type="submit">Cari Reservasi</button></form>
<% if (reservation) { %><section class="card result-card"><div class="status <%= reservation.status.toLowerCase() %>"><%= reservation.status %></div><h2><%= reservation.booking_code %></h2><div class="detail-grid"><div><span>PC</span><strong><%= reservation.computer_code %></strong></div><div><span>Tanggal</span><strong><%= formatDate(reservation.booking_date) %></strong></div><div><span>Jam</span><strong><%= toTime(reservation.start_time) %> - <%= toTime(reservation.end_time) %></strong></div><div><span>Pembayaran</span><strong><%= reservation.payment_status %> / CASH</strong></div><div><span>Total</span><strong><%= currency(reservation.total_price) %></strong></div></div></section><% } %>
<%- include('partials/footer') %>
